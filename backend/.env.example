# Local development settings. Copy to .env and adjust.
# DATABASE_URL points at PostgreSQL in production. SQLite is used for
# laptop development and the test harness.
DATABASE_URL=sqlite:///./longithread.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/longithread

# Never commit real secrets. Hosted LLM keys are optional; the MVP ships a
# deterministic extractor so it runs and is evaluated without any API key.
OPENAI_API_KEY=

ENVIRONMENT=development
